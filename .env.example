# Copy to .env and fill in the keys for the provider(s) you use.
# refract reads these at runtime; .env itself is gitignored.

# --- LLM provider API keys ---------------------------------------------------
# OpenAI (provider=openai). https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini (provider=gemini). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key

# --- Provider selection ------------------------------------------------------
# Which provider to use when --provider is not passed. One of: openai, gemini
REFRACT_PROVIDER=openai

# Override the default model for the chosen provider (optional).
# Defaults: openai -> gpt-4.1, gemini -> gemini-2.5-pro
# REFRACT_MODEL=gpt-4.1

# --- Advanced ----------------------------------------------------------------
# Override the OpenAI base URL (used by the benchmark counting proxy; optional).
# OPENAI_BASE_URL=https://api.openai.com
